# Backend configuration. Copy to .env and fill in, or export these in your shell.
# application.properties has local-development defaults for everything except
# production, where application-prod.properties requires every value.

DB_URL=jdbc:postgresql://localhost:5432/jobtracker
DB_USER=jobtracker
DB_PASSWORD=jobtracker_dev

# HS256 signing key. Must be at least 32 bytes; the app refuses to start otherwise.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-real-secret-of-at-least-32-bytes!!
JWT_EXPIRATION=86400

# Explicit allow-list, comma-separated. No wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:5173

UPLOAD_DIR=./uploads

# Resume storage: "local" (default) writes under UPLOAD_DIR and needs a
# persistent disk. "supabase" writes to a Supabase Storage bucket instead —
# use this on hosts with an ephemeral filesystem (e.g. Render's free tier).
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=resumes
